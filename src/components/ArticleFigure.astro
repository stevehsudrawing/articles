---
import ThemeImage from "./ThemeImage.astro";
import { figurePlacement, type FigureAlign } from "../figure";
import type { ThemeImageProps } from "../theme-image";

interface Props {
  /**
   * Everything about the image itself.
   *
   * `alt` is required here because a figure's description is content. The
   * object's `class` names the image; this component's own `class` names the
   * `<figure>`.
   */
  image: ThemeImageProps & { alt: string };
  /** Information the image does not carry, rendered under it. */
  caption?: string;
  /**
   * Whether the following prose wraps beside the figure, from `lg` up in the
   * standard view. A float needs a side.
   */
  float?: boolean;
  /**
   * The side the figure sits on, or floats to: centered by default, and
   * effective only from `lg` up in the standard view.
   */
  align?: FigureAlign;
  /** The figure's own box: the classes a rule matches, not the image's. */
  class?: string;
}

// The pair is `ThemeImage`'s and the theme is the two rules in `base.scss`, so a
// figure adds no second copy of either. An image drawn at its own size passes no
// `widths`: one candidate per format per half, and no `sizes` to choose between
// them.
const {
  image,
  caption,
  float = false,
  align = "center",
  class: className,
} = Astro.props;
const classes = [...figurePlacement({ float, align }), className]
  .filter(Boolean)
  .join(" ");
---

<figure class={classes}>
  <ThemeImage {...image} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
