---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale, locales, type Locale } from "../i18n/locales";

interface Props {
  /** The locale whose home this stands in for. */
  locale: Locale;
}

// A placeholder for the locale home: the three locale routes share it until
// the real home page arrives.
const entry = getLocale(Astro.props.locale);
const links = locales.map((locale) => ({
  ...locale,
  href: getRelativeLocaleUrl(locale.identity),
}));
---

<!doctype html>
<html lang={entry.tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{entry.name}</title>
  </head>
  <body>
    <p>{entry.name}</p>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} lang={link.tag}>
            {link.name}
          </a>
        </li>
      ))}
    </ul>
  </body>
</html>
