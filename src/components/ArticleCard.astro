---
import { articleUrl, coverPair, type Article } from "../articles";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import Icon from "./Icon.astro";

interface Props {
  /** The locale whose URLs the card links to. */
  locale: Locale;
  /** The article to show. */
  article: Article;
}

// The card links to the current locale and lets the redirect happen: the rule
// that decides which URLs a locale lacks then keeps one home.
const { locale, article } = Astro.props;
const href = articleUrl(locale, article.id);
const { light, dark, width, height } = coverPair(article);
const date = article.data.date;
const updated = article.data.updated;
const author = article.data.author;

// Both halves of a pair are below the fold in the same way, so both are lazy -
// the same deferral the card's single image already had. The attributes are the
// ones the toggle in `base.css` keys on; a card whose article has no dark twin
// writes neither, and keeps its light cover in both themes.
const coverAttrs = {
  class: "card-img-top article-card-cover border-bottom",
  width,
  height,
  alt: "",
  loading: "lazy",
} as const;
---

<div class="col-md-6 col-xl-4">
  <article class="card h-100">
    <a href={href} tabindex="-1" aria-hidden="true">
      <img
        {...coverAttrs}
        src={light}
        data-theme-image={dark ? "light" : undefined}
      />
      {dark && <img {...coverAttrs} src={dark} data-theme-image="dark" />}
    </a>
    <div class="card-body d-flex flex-column">
      <h2 class="card-title h5">
        <a href={href}>{article.data.title}</a>
      </h2>
      <p class="card-text text-body-secondary mb-auto">
        {article.data.description}
      </p>
      <p class="card-text text-body-secondary mt-1 mb-0 small font-tnum d-flex gap-2 flex-wrap">
        <span>
          {updated ? (
            <>
              <span class="card-icon">
                <Icon name="update" />
              </span>
              <span>{updated}</span>
            </>
          ) : (
            <>
              <span class="card-icon">
                <Icon name="calendarToday" />
              </span>
              <span>{date}</span>
            </>
          )}
        </span>
        {author && author !== t(locale, "text-site-author") && (
          <span>
            <span class="card-icon">
              <Icon name="person" />
            </span>
            <span>{author}</span>
          </span>
        )}
      </p>
    </div>
  </article>
</div>

<style>
  /* The list thumbnails crop to 16:9, which discards 3.3% from each side. The
     hero keeps 4:3 because it has the room; a card does not - a 4:3 thumbnail
     would make every row taller than the text beside it. Both crops stay inside
     the authoring rule's central 70%, so a cover composed for the hero is safe
     here too.

     `height: auto` is load-bearing: the `<img>` carries
     `height="630"` for its intrinsic ratio, and that attribute is a
     presentational hint - an explicit height, which beats `aspect-ratio`. With
     the hint winning, the measured box was 366x630 instead of 366x206. */
  .article-card-cover {
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
  }

  /* A glyph is a `1em` box sitting on the text's baseline, so an inline one
     leaves a descender's worth of gap under it: `inline-flex` blockifies it and
     takes the gap away, and `-0.125em` drops the box onto the digits' optical
     baseline - the same correction `SiteHeader.vue` makes for its own glyphs.
     The margin is the only space before the value: measured in the 14px card
     text, the glyph is 14x14, its box bottom sits 1.58px below the digits',
     and the gap to the first digit is 1.75px, which is the margin alone - the
     whitespace between the two spans does not survive the template compiler. */
  .card-icon {
    display: inline-flex;
    vertical-align: -0.125em;
    margin-right: 0.125em;
  }
</style>
