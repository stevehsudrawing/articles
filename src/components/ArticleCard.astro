---
import { articleUrl, coverPair, type Article } from "../articles";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import Icon from "./Icon.astro";
import ThemeImage from "./ThemeImage.astro";

interface Props {
  /** The locale whose URLs the card links to. */
  locale: Locale;
  /** The article to show. */
  article: Article;
}

// The card links to the current locale and lets the redirect happen: the rule
// that decides which URLs a locale lacks then keeps one home.
const { locale, article } = Astro.props;
const href = articleUrl(locale, article.id);
const { light, dark } = coverPair(article);
const date = article.data.date;
const updated = article.data.updated;
const author = article.data.author;

// The thumbnail's box, breakpoint by breakpoint, measured on the list at every
// width the grid changes shape at. It is widest when the card is alone in its
// row - 515 between the `sm` and `md` container widths - which is why the steps
// are not one descending ladder.
const COVER_SIZES =
  "(min-width: 1400px) 426px, (min-width: 1200px) 366px, (min-width: 992px) 463px, (min-width: 768px) 343px, (min-width: 576px) 515px, calc(100vw - 40px)";

// Both halves of a pair are below the fold in the same way, so both are lazy -
// the same deferral the card's single image already had, and `loading="lazy"`
// also means a hidden half is never requested.
//
// `alt` is empty because the link around the image is `aria-hidden` and takes
// no focus: the card's accessible name is the title link below it, so the
// thumbnail is a second copy of that name rather than a picture to describe.
---

<div class="col-md-6 col-xl-4">
  <article class="card h-100">
    <a href={href} tabindex="-1" aria-hidden="true">
      <ThemeImage
        light={light}
        dark={dark}
        alt=""
        class="card-img-top article-card-cover border-bottom"
        sizes={COVER_SIZES}
      />
    </a>
    <div class="card-body d-flex flex-column">
      <h2 class="card-title h5">
        <a href={href}>{article.data.title}</a>
      </h2>
      <p class="card-text text-body-secondary mb-auto">
        {article.data.description}
      </p>
      <p class="card-text text-body-secondary mt-1 mb-0 small font-tnum d-flex gap-2 flex-wrap">
        <span>
          {updated ? (
            <>
              <span class="text-icon card-icon">
                <Icon name="update" />
              </span>
              <span>{updated}</span>
            </>
          ) : (
            <>
              <span class="text-icon card-icon">
                <Icon name="calendarToday" />
              </span>
              <span>{date}</span>
            </>
          )}
        </span>
        {author && author !== t(locale, "text-site-author") && (
          <span>
            <span class="text-icon card-icon">
              <Icon name="person" />
            </span>
            <span>{author}</span>
          </span>
        )}
      </p>
    </div>
  </article>
</div>

<style>
  /* The list thumbnails crop to 16:9, which discards 3.3% from each side. The
     hero keeps 4:3 because it has the room; a card does not - a 4:3 thumbnail
     would make every row taller than the text beside it. Both crops stay inside
     the authoring rule's central 70%, so a cover composed for the hero is safe
     here too.

     `height: auto` is load-bearing: the `<img>` carries
     `height="630"` for its intrinsic ratio, and that attribute is a
     presentational hint - an explicit height, which beats `aspect-ratio`. With
     the hint winning, the measured box was 366x630 instead of 366x206. */
  .article-card-cover {
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
  }

  /* `.text-icon` in `base.css` blockifies the glyph and puts it on the text's
     optical baseline. What is left here is the measured space before the value:
     in the 14px card text the glyph is 14x14, its box bottom sits 1.75px below
     the baseline - exactly `-0.125em` at 14px - and the gap to the first digit
     is 1.75px, which is this margin alone; the whitespace between the two spans
     does not survive the template compiler. */
  .card-icon {
    margin-right: 0.125em;
  }
</style>
