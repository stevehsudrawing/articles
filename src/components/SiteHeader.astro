---
// The header is markup: the bar, the navigation and the two controls, built
// from Bootstrap's classes and `<details>` rather than from components. A
// `<summary>` is a disclosure control the platform already has - it is
// keyboard-operable and it carries its own expanded state - so the page ships
// no script for any of this, and the one script at the end of the file only
// adds the closing gestures the element does not have.
//
// Wide: one row - the mark, the navigation, then the two dropdowns.
// Narrow: the same 64 px row with the mark centered, a menu button on the left
// and a settings button on the right, so the navigation and the two settings
// live in two panels. The centered cell holds the mark and, once the page is
// scrolled, the page's own name, which returns the reader to the top: one
// slides out as the other slides in. A panel rather than a list that grows the
// bar, because `--shar-header-height` is what the sticky header, the article's
// sidebar and `scroll-padding-top` all read, and a list that grew the header
// would make every one of them wrong while it was open.
import { getRelativeLocaleUrl } from "astro:i18n";
import { listUrl } from "../articles";
import mark from "../assets/brand/mark.svg?raw";
import { locales, localeIdentities, type Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import type { IconName } from "../icons";
import { tagIndexUrl } from "../tags";
import Icon from "./Icon.astro";

/** One link in the header's navigation. */
interface NavLink {
  href: string;
  label: string;
  current: boolean;
}

/** One entry in the language switcher. */
interface LanguageLink {
  /** The BCP-47 tag, for `lang` and `hreflang`. */
  tag: string;
  /** The language's own name. */
  name: string;
  href: string;
  current: boolean;
  /** Whether the locale holds this page, which a missing one renders disabled. */
  available: boolean;
}

/** One theme choice. */
interface ThemeOption {
  value: "auto" | "light" | "dark";
  label: string;
  icon: IconName;
  /** Whether this is the choice the page starts with, which a script may change. */
  current: boolean;
}

interface Props {
  /** The locale the page is written in; every label and link follows it. */
  locale: Locale;
  /**
   * Which of the header's items this page is, for `aria-current`. A page kind
   * declares it, because the address does not answer it: a tag page's URL is
   * `/tags/<tag>/`, and it still marks the tag index.
   */
  page?: "home" | "list" | "tags";
  /**
   * The page's own path inside its locale, which the language links keep. The
   * path is shared, and which locales serve a page of their own is what
   * `languages` answers.
   */
  path?: string;
  /**
   * The page's `h1` text, which the header shows in place of the mark below
   * the breakpoint. The page renders it; the header only repeats it.
   */
  heading: string;
  /**
   * The locales that hold this page. An article passes the set its translations
   * make; a page kind that exists in every locale passes nothing and gets the
   * whole table.
   */
  languages?: Locale[];
}

const {
  locale,
  page,
  path = "",
  heading,
  languages: availableLocales = localeIdentities,
} = Astro.props;

const siteName = t(locale, "text-site-name");

// The list's own URL is its first page: `/page/` exists only as a redirect, and
// no in-site link should need one. The tag index follows the same shape, and
// both paths come from the modules that build them, because the breadcrumb is
// their third reader.
const nav: NavLink[] = [
  { kind: "home", href: getRelativeLocaleUrl(locale, "") },
  { kind: "list", href: listUrl(locale) },
  { kind: "tags", href: tagIndexUrl(locale) },
].map(({ kind, href }) => ({
  href,
  label: t(locale, `text-nav-${kind}`),
  current: page === kind,
}));

// A locale the page does not exist in is a disabled row rather than a link, so a
// reader is never sent through the redirect page that stands at its URL. The set
// `localesWith()` returns leaves a draft out; the current locale stays available
// regardless, because a draft is served at its own URL although it is not
// advertised as a translation.
const languageLinks: LanguageLink[] = locales.map((other) => ({
  tag: other.tag,
  name: other.name,
  href: getRelativeLocaleUrl(other.identity, path),
  current: other.identity === locale,
  available:
    other.identity === locale || availableLocales.includes(other.identity),
}));

const themes: ThemeOption[] = (
  [
    ["auto", "contrast"],
    ["light", "lightMode"],
    ["dark", "darkMode"],
  ] as const
).map(([value, icon]) => ({
  value,
  icon,
  label: t(locale, `text-action-theme-${value}`),
  // `auto` is the theme script's default, so the markup marks the same item a
  // scriptless page would be showing; the script corrects it on load.
  current: value === "auto",
}));

const currentLanguage =
  languageLinks.find((entry) => entry.current) ?? languageLinks[0];
---

<header class="site-header sticky-top bg-body">
  <nav class="navbar navbar-expand-md">
    {/* Below `md` this is a grid: the two buttons take the outer columns and
        the mark takes the middle one. At `md` it is Bootstrap's flex row. */}
    <div class="container site-header-row d-grid d-md-flex align-items-center">
      <details
        class="site-menu site-menu-panel site-menu-nav d-md-none"
        id="site-nav"
        name="site-menu"
      >
        <summary
          class="site-header-control"
          aria-label={t(locale, "text-action-menu")}
        >
          <span class="text-icon" aria-hidden="true">
            <Icon name="menu" />
          </span>
        </summary>
        <div class="site-panel-scrim" data-menu-scrim aria-hidden="true"></div>
        <div class="site-panel">
          <h6 class="site-panel-group">{siteName}</h6>
          <ul class="navbar-nav">
            {nav.map((link) => (
              <li class="nav-item">
                <a
                  class:list={["nav-link", { active: link.current }]}
                  href={link.href}
                  aria-current={link.current ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>

      <div class="site-brand">
        <a
          class="navbar-brand site-header-brand m-0"
          href={nav[0].href}
          aria-label={siteName}
        >
          <span class="site-header-mark" aria-hidden="true">
            <Fragment set:html={mark} />
          </span>
        </a>
        <a class="site-brand-name" href="#top">
          <span>{heading}</span>
        </a>
      </div>

      <ul class="navbar-nav d-none d-md-flex me-auto ms-2">
        {nav.map((link) => (
          <li class="nav-item">
            <a
              class:list={["nav-link", { active: link.current }]}
              href={link.href}
              aria-current={link.current ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <ul class="navbar-nav d-none d-md-flex">
        <li class="nav-item dropdown">
          <details class="site-menu">
            <summary class="nav-link">
              <span class="text-icon me-1" aria-hidden="true">
                <Icon name="language" />
              </span>
              <span>{currentLanguage.name}</span>
              <span class="site-menu-caret text-icon" aria-hidden="true">
                <Icon name="arrowDropDown" />
              </span>
            </summary>
            <ul class="dropdown-menu">
              {languageLinks.map((language) => (
                <li>
                  {language.available ? (
                    <a
                      class:list={[
                        "dropdown-item",
                        { active: language.current },
                      ]}
                      href={language.href}
                      lang={language.tag}
                      hreflang={language.tag}
                      aria-current={language.current ? "true" : undefined}
                    >
                      {language.name}
                    </a>
                  ) : (
                    <span
                      class="dropdown-item disabled"
                      role="link"
                      aria-disabled="true"
                      lang={language.tag}
                    >
                      {language.name}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </details>
        </li>

        <li class="nav-item dropdown" data-theme-group hidden>
          <details class="site-menu">
            <summary class="nav-link">
              {themes.map((option) => (
                <span class="site-theme-option" data-for={option.value}>
                  <span class="text-icon me-1" aria-hidden="true">
                    <Icon name={option.icon} />
                  </span>
                  <span>{option.label}</span>
                </span>
              ))}
              <span class="site-menu-caret text-icon" aria-hidden="true">
                <Icon name="arrowDropDown" />
              </span>
            </summary>
            <ul class="dropdown-menu">
              {themes.map((option) => (
                <li>
                  <button
                    class:list={["dropdown-item", { active: option.current }]}
                    type="button"
                    data-theme-option={option.value}
                  >
                    <span class="text-icon me-2" aria-hidden="true">
                      <Icon name={option.icon} />
                    </span>
                    {option.label}
                  </button>
                </li>
              ))}
            </ul>
          </details>
        </li>
      </ul>

      <details
        class="site-menu site-menu-panel site-menu-settings d-md-none"
        id="site-settings"
        name="site-menu"
      >
        <summary
          class="site-header-control"
          aria-label={t(locale, "text-action-settings")}
        >
          <span class="text-icon" aria-hidden="true">
            <Icon name="settings" />
          </span>
        </summary>
        <div class="site-panel-scrim" data-menu-scrim aria-hidden="true"></div>
        <div class="site-panel">
          <h6 class="site-panel-group" id="site-settings-language">
            {t(locale, "text-action-language")}
          </h6>
          <ul class="navbar-nav" aria-labelledby="site-settings-language">
            {languageLinks.map((language) => (
              <li class="nav-item">
                {language.available ? (
                  <a
                    class:list={["nav-link", { active: language.current }]}
                    href={language.href}
                    lang={language.tag}
                    hreflang={language.tag}
                    aria-current={language.current ? "true" : undefined}
                  >
                    {language.name}
                  </a>
                ) : (
                  <span
                    class="nav-link disabled"
                    role="link"
                    aria-disabled="true"
                    lang={language.tag}
                  >
                    {language.name}
                  </span>
                )}
              </li>
            ))}
          </ul>

          <div data-theme-group hidden>
            <h6 class="site-panel-group mt-3" id="site-settings-theme">
              {t(locale, "text-action-theme")}
            </h6>
            <ul class="navbar-nav" aria-labelledby="site-settings-theme">
              {themes.map((option) => (
                <li class="nav-item">
                  <button
                    class:list={["nav-link", { active: option.current }]}
                    type="button"
                    data-theme-option={option.value}
                  >
                    <span class="text-icon me-2" aria-hidden="true">
                      <Icon name={option.icon} />
                    </span>
                    {option.label}
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>

<script is:inline>
  // A `<details>` opens and closes from its own summary and from nothing else,
  // so the three closing gestures a reader expects from a menu are added here:
  // Escape, a click on the scrim behind a panel, and a click outside a wide
  // dropdown. Inline rather than bundled, because a bundled script is a file
  // every page downloads.
  (() => {
    // A theme choice cannot work without script, so the control it would drive
    // is rendered with `hidden` and appears only once a script has run. This is
    // the earliest such script, so nothing flashes.
    for (const group of document.querySelectorAll("[data-theme-group]")) {
      group.hidden = false;
    }

    const openMenus = () =>
      document.querySelectorAll("details.site-menu[open]");

    // `name` already makes the four menus exclusive in current browsers; this
    // is the same rule for the ones that predate the attribute.
    for (const menu of document.querySelectorAll("details.site-menu")) {
      menu.addEventListener("toggle", () => {
        if (!menu.open) return;

        for (const other of openMenus()) {
          if (other !== menu) other.open = false;
        }
      });
    }

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;

      for (const menu of openMenus()) {
        menu.open = false;
        menu.querySelector("summary").focus();
      }
    });

    // A click inside a menu is that menu's own business - on its summary it
    // toggles, on a link it navigates. A click on the scrim or outside closes.
    document.addEventListener("click", (event) => {
      for (const menu of openMenus()) {
        if (menu.contains(event.target)) {
          if (!event.target.closest("[data-menu-scrim]")) continue;
        }

        menu.open = false;
      }
    });
  })();
</script>

<style scoped>
  /* The header's own layer and its height come from `parameters.css`, so the
     sticky offset, the sidebar's offset and `scroll-padding-top` cannot drift
     apart - which is why the narrow layout is a panel rather than something that
     grows the bar. */
  .site-header {
    height: var(--shar-header-height);
    z-index: var(--shar-z-header);

    /* The seam under the bar is drawn once the page is scrolled. The border is
       always there at its final width and only its color moves, so the bar's
       height never changes and `--shar-header-height` stays the one number the
       sticky offset, the contents' `max-height` and `scroll-padding-top` read. */
    border-bottom: var(--bs-border-width) solid transparent;
  }

  /* The wrapper and the name exist only below the breakpoint, where the wrapper
     becomes the two layers' cell. Above it the wrapper is not a box at all, so
     the mark keeps the row's own cell and the bar's order. These defaults come
     before the breakpoint's rules so the breakpoint's wins. */
  .site-brand {
    display: contents;
  }

  /* The name is the page's own `h1` text, so it keeps the page's color instead
     of taking the link color, and only the underline arrives on hover - in that
     same color, since `base.scss` would otherwise give it the accent.

     The wrapper is the link: the `#top` fragment resolves to the document top
     with no element named for it, the same assumption the article's tools bar
     makes. */
  .site-brand-name {
    display: none;
    color: inherit;
    text-decoration: none;
  }

  .site-brand-name:hover {
    text-decoration: underline currentColor;
  }

  /* Without a timeline the seam would still be painted: `animation-duration:
     auto` resolves to 0s, and `fill: both` then holds the finished frame, which
     leaves the border at `rgb(222, 226, 230)` from the top of every page. The
     gate is what keeps the seam a scroll effect. */
  @supports (animation-timeline: scroll()) {
    .site-header {
      /* `animation-range: 0 1px` compresses the whole timeline into the page's
         first pixel, which makes "scrolled past the top" and "progress 100%" the
         same fact; `fill: both` holds it for the rest of the scroll. A 0s
         duration with a single `to` keyframe would instead say "this page can
         scroll" - it draws the line at the top of a long page, where the header
         is still in flow and nothing is under it, and it keeps the line after a
         viewport resize makes the page stop overflowing.

         Longhands, never the `animation` shorthand: folding it together with
         `animation-timeline` produces grammar the browser rejects and the whole
         declaration disappears. And no `transition`: an animation in effect
         outranks one on the same property, so it would never run - which is also
         why nothing here needs a reduced-motion guard. */
      animation-name: shar-header-edge;
      animation-duration: auto;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
      animation-range: 0 1px;
    }

    /* Below the breakpoint the brand's cell stacks the mark and the page's own
       name, and the scroll moves one out as it moves the other in. Both travel
       the bar's height rather than a percentage of their boxes: the mark's box
       is the 32 px glyph inside this 64 px row, so a percentage would leave
       half of it inside the bar, and the name's box is one line tall.

       `visibility` is what takes the mark out of the tab order once it is gone:
       it is discrete, it stays visible at every step but the last, and a hidden
       link cannot be focused. */
    @media (max-width: 767.98px) {
      /* The bar clips its own contents, so the name rises exactly out of the
         bar's bottom edge and the mark slides out of its top instead of
         floating above it. The panels stay whole: they are `position: fixed`,
         and a fixed box is not clipped by an ancestor's overflow. */
      .site-header {
        overflow: hidden;
      }

      .site-brand {
        display: grid;
        grid-template-rows: 1fr;
        align-items: center;
        height: 100%;
      }

      .site-header-brand {
        grid-area: 1 / 1;
        /* The cell is as wide as the name, so the anchor keeps its own 32 px
           box instead of stretching across it - a stretched anchor paints the
           hover fill as a bar the width of the name. */
        justify-self: center;
        animation-name: shar-brand-mark-out;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0 16rem;
      }

      /* The link carries the animation, not its text: `visibility` is what
         keeps the name out of the tab order before its text is on screen, and
         a hidden child inside a visible link would still be a stop. */
      .site-brand-name {
        display: flex;
        grid-area: 1 / 1;
        align-self: stretch;
        align-items: center;
        justify-content: center;
        /* On a document too short to scroll, the timeline is inactive and
           neither animation contributes anything, so the bar falls back to
           these two values: the `from` frame, with the name not yet in. */
        transform: translateY(var(--shar-header-height));
        visibility: hidden;
        animation-name: shar-brand-name-in;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0 16rem;
      }

      .site-brand-name > span {
        max-inline-size: 60vw;
        overflow: hidden;
        font-size: 1rem;
        font-weight: 500;
        white-space: nowrap;
        text-overflow: ellipsis;
      }
    }
  }

  @keyframes shar-header-edge {
    from {
      border-bottom-color: transparent;
    }

    to {
      border-bottom-color: var(--bs-border-color);
    }
  }

  @keyframes shar-brand-mark-out {
    from {
      transform: translateY(0);
    }

    to {
      transform: translateY(calc(-1 * var(--shar-header-height)));
      visibility: hidden;
    }
  }

  @keyframes shar-brand-name-in {
    from {
      transform: translateY(var(--shar-header-height));
      visibility: hidden;
    }

    /* The name's first pixel enters the bar at 30 % of the ramp, so the link
       joins the tab order exactly there rather than offering a focus stop
       nobody can see. */
    30% {
      visibility: hidden;
    }

    to {
      transform: translateY(0);
      visibility: visible;
    }
  }

  .site-header .navbar,
  .site-header-row {
    height: 100%;
  }

  /* Below `md` the two buttons take the outer columns, so the mark in the middle
     one is centered whatever width the glyphs happen to have. Bootstrap's own
     `-md` breakpoint is `max-width: 767.98px`. */
  @media (max-width: 767.98px) {
    .site-header-row {
      grid-template-columns: 1fr auto 1fr;
    }
  }

  /* A `summary` is a control, so it takes the bar button's box rather than a
     list item's: the marker goes, and the glyph and the label share a row. */
  .site-header-control {
    display: flex;
    align-items: center;
    height: 2rem;
    width: 1.1rem;
    padding: 0;
    border: 0;
    line-height: 1;
    color: rgba(var(--bs-body-color-rgb), 0.8);
    background-color: transparent;
    list-style: none;
    cursor: pointer;
  }

  .site-header-control::-webkit-details-marker {
    display: none;
  }

  /* The settings button is the row's last column, so its glyph sits against the
     right edge whatever the grid's fractions are. */
  .site-menu-settings {
    justify-self: end;
  }

  .site-menu > summary.nav-link {
    display: flex;
    align-items: center;
    list-style: none;
    cursor: pointer;
  }

  .site-menu > summary.nav-link::-webkit-details-marker {
    display: none;
  }

  /* The open state is what Bootstrap's `.show` said, said by the element itself. */
  .site-menu[open] > summary {
    color: var(--bs-link-hover-color);
  }

  /* The caret says what a wide trigger does. It turns while the menu is open -
     `rotate` rather than a `transform`, so nothing else on the summary is
     touched - and it carries no transition, because the header is flat. */
  .site-menu-caret {
    margin-inline-start: 0.25rem;
    opacity: var(--shar-decoration-opacity);
  }

  .site-menu[open] > summary .site-menu-caret {
    rotate: 180deg;
  }

  /* 0.2rem of outline around the 32 px glyph leaves 12.8 px of room above and
     below it in the 64 px row, and an outline reserves that paint from the
     first frame where padding would grow the row's content. The filled box is
     also what the keyboard shows: `base.scss` draws a 2 px ring on links, and
     this box replaces it on this one link. */
  .site-header-brand {
    display: flex;
    align-items: center;
    /* Bootstrap pads a `.navbar-brand` by 5 px top and bottom for a text mark.
       This one is a glyph, and a box with 5 px of slack inside the fill is not
       the glyph's box. */
    padding: 0;
    outline: 0.2rem solid rgba(var(--bs-primary-rgb), 0);
    outline-offset: 0;
    transition:
      background-color var(--shar-duration-fast) linear,
      outline-color var(--shar-duration-fast) linear;
  }

  .site-header-brand:hover,
  .site-header-brand:focus-visible,
  .site-header-brand:active {
    background-color: var(--bs-primary);
    outline: 0.2rem solid rgba(var(--bs-primary-rgb), 1);
  }

  .site-header-mark {
    font-size: 2rem;
    color: var(--bs-primary);
    transition: color var(--shar-duration-fast) linear;
  }

  /* The glyph paints with `currentColor`, so the anchor's state has to set the
     mark's own `color`: `.navbar-brand` gives the anchor a `color` of its own,
     which nothing here inherits. */
  .site-header-brand:hover .site-header-mark,
  .site-header-brand:focus-visible .site-header-mark,
  .site-header-brand:active .site-header-mark {
    color: var(--shar-primary-contrast);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header-brand,
    .site-header-mark {
      transition: none;
    }
  }

  /* `set:html` output carries no scope attribute, so the mark's own element is
     named globally - the wrapper is what limits it to this component. */
  .site-header-mark :global(svg) {
    display: block;
    width: 1em;
    height: 1em;
  }

  /* The baseline correction every glyph here needs is `.text-icon` in `base.scss`,
     which the cards, the alerts and the footer share. What the header adds is the
     size: a hair larger than the text the glyph sits beside. */
  .text-icon :global(svg) {
    display: block;
    width: 1.1em;
    height: 1.1em;
  }

  /* The panel begins where the bar ends: its summary is its only close control,
     so the bar has to stay reachable. Being out of the flow is also what keeps
     the bar's height a fact while a panel is open. */
  .site-panel,
  .site-panel-scrim {
    position: fixed;
    inset-block: var(--shar-header-height) 0;
  }

  .site-panel-scrim {
    inset-inline: 0;
    z-index: 1;
    background-color: rgba(
      var(--bs-body-bg-rgb),
      var(--shar-decoration-opacity)
    );
    backdrop-filter: var(--shar-backdrop-filter);
  }

  .site-panel {
    /* Bootstrap's `--bs-offcanvas-padding-*` are declared inside `.offcanvas`,
       which no page renders any more - and a `var()` with no value makes the
       whole `padding` shorthand invalid, which computes to 0. The panel owns
       its own number, and its headings and rows read it. */
    --site-panel-padding: 1rem;

    z-index: 2;
    inline-size: min(320px, 85vw);
    overflow-y: auto;
    padding: var(--site-panel-padding) 0;
    background-color: var(--bs-body-bg);
  }

  .site-menu-nav > .site-panel {
    inset-inline-start: 0;
    border-inline-end: var(--shar-border);
  }

  .site-menu-settings > .site-panel {
    inset-inline-end: 0;
    border-inline-start: var(--shar-border);
  }

  .site-panel .site-panel-group {
    padding: 0 var(--site-panel-padding);
  }

  .site-panel .nav-link {
    display: flex;
    align-items: center;
    width: 100%;
