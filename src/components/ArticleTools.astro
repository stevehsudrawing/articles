---
import Icon from "./Icon.astro";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import { DEFAULT_READING_SCALE, READING_SCALES } from "../reading";

interface Props {
  /** The locale whose copy labels every control. */
  locale: Locale;
  /**
   * Where the bar sits. `rail` is the right rail at `xl` and above, after the
   * table of contents; `dock` is the end of `main` below `xl`.
   */
  placement: "rail" | "dock";
}

// One component, two placements, because the two are not the same node. The
// rail copy's sticky containing block is the rail column, whose bottom edge is
// the end of the article; the dock copy's is `main`, whose bottom edge is the
// footer's top. That is what makes `position: sticky; bottom: 0` do the whole
// job with no script and no measurement.
//
// The placement is the component's own two modifiers, not Bootstrap's display
// utilities: those carry `!important`, so neither the breakpoint nor the mode
// attribute could override them. Both copies are decided in the style block
// below, in one place.
//
// The component holds no script: it is rendered twice, so the behavior belongs
// to `Article.astro`, which renders both copies.
const { locale, placement } = Astro.props;

const backToTop = t(locale, "text-action-back-to-top");
const comfortView = t(locale, "text-action-view-comfort");
const fontDecrease = t(locale, "text-action-font-decrease");
const fontIncrease = t(locale, "text-action-font-increase");

// The steps reach the page's inline script through the bar's own attributes,
// because an inline script cannot import. Both copies carry the same pair, from
// this one list.
const readingSteps = READING_SCALES.join(" ");
const readingDefault = String(DEFAULT_READING_SCALE);
---

<div
  class:list={[
    "article-tools align-items-center px-3 px-xl-0",
    placement === "rail"
      ? "article-tools--rail"
      : "article-tools--dock border-top",
  ]}
  data-reading-steps={readingSteps}
  data-reading-default={readingDefault}
>
  <a class="article-tools-control" href="#top" aria-label={backToTop}>
    <span class="article-tools-icon" aria-hidden="true">
      <Icon name="arrowUpward" />
    </span>
  </a>
  <button
    class="article-tools-control"
    type="button"
    data-reading-step="-1"
    aria-label={fontDecrease}
  >
    <span class="article-tools-icon" aria-hidden="true">
      <Icon name="textDecrease" />
    </span>
  </button>
  <button
    class="article-tools-control"
    type="button"
    data-reading-step="1"
    aria-label={fontIncrease}
  >
    <span class="article-tools-icon" aria-hidden="true">
      <Icon name="textIncrease" />
    </span>
  </button>
  <button
    class="article-tools-control"
    type="button"
    data-view-toggle
    aria-pressed="false"
    aria-label={comfortView}
  >
    <span class="article-tools-icon" aria-hidden="true">
      <Icon name="formatAlignCenter" />
    </span>
  </button>
</div>

<style>
  /* Sticky, never fixed: the bar stays in flow, so what lifts it is the
     document's own structure rather than an offset someone measured.

     `margin-top: auto` is what puts the bar at the bottom of its containing
     block, and both placements need it. `position: sticky; bottom: 0` only ever
     moves an element up - it never pushes one down - so a bar left at the top of
     an empty stretch would ride up with the document instead of floating.

     The separating `border-top` is the dock copy's alone. Below `xl` the article
     scrolls under the bar, which is why that copy also needs the opaque
     background; in the rail nothing ever passes beneath it, and a line across
     the rail would separate the bar from nothing while standing beside the
     article's own footer rule at the bottom of the page - half its width, in the
     neighboring column, reading as two lines that failed to meet. The
     background stays on both: one declaration serves the two placements, and
     only the dock copy needs it. */
  .article-tools {
    position: sticky;
    bottom: 0;
    flex: none;
    margin-top: auto;
    z-index: var(--shar-z-tools);
    height: var(--shar-tools-height);
    background-color: var(--bs-body-bg);
  }

  /* Where each copy sits, in one place. The rail copy is the right rail's bar at
     `xl` and above; the dock copy is the end of `main` below it. */
  .article-tools--rail {
    display: none;
    justify-content: flex-end;
  }

  .article-tools--dock {
    display: flex;
    justify-content: space-around;
  }

  @media (min-width: 1200px) {
    .article-tools--rail {
      display: flex;
    }

    .article-tools--dock {
      display: none;
    }
  }

  /* The comfortable view docks the bar at every width, capped at the measure and
     centered, so it spreads its controls under the column they act on. At 1440
     `space-around` across the viewport would put one glyph at each edge, which is
     a toolbar-shaped void rather than a bar beside the article. `width: 100%` is
     load-bearing: with an auto cross-axis margin a flex item stops stretching,
     so without it the bar would shrink onto its own glyphs. */
  :root[data-reading-view="comfort"] .article-tools--rail {
    display: none;
  }

  :root[data-reading-view="comfort"] .article-tools--dock {
    display: flex;
    width: 100%;
    max-width: var(--shar-measure);
    margin-inline: auto;
  }

  /* The same gate `base.css` puts in front of its scale rules: the scale has no
     definition until a size is chosen, and a `calc` over a missing custom
     property is invalid, so the plain measure is what applies until then. */
  :root[data-reading-view="comfort"][data-reading-scale] .article-tools--dock {
    max-width: calc(var(--shar-measure) * var(--shar-reading-scale));
  }

  /* 44 px is the smallest comfortable thumb target. The glyph is sized as a
     `font-size` on this wrapper because `Icon.astro` renders through
     `set:html`, so the SVG carries no scope attribute and no scoped rule can
     name it. The color is the header control's own, so the two bars read as one
     system, and the underline is canceled because `base.css` gives every
     anchor one.

     The class serves an anchor and two buttons, so the UA chrome a `<button>`
     carries - its padding, border and background - is removed here rather than
     restated per element. */
  .article-tools-control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    font-size: 1.5rem;
    color: rgba(var(--bs-body-color-rgb), 0.8);
    text-decoration: none;
    background-color: transparent;
  }

  .article-tools-control:hover {
    color: var(--bs-body-color);
  }

  /* The end of the range. `aria-disabled` rather than `disabled`, so the control
     keeps focus instead of dropping it under a keyboard reader's fingers;
     `pointer-events` is what makes it unclickable, and the handler still guards
     the range because a keyboard activation dispatches a click regardless. */
  .article-tools-control[aria-disabled="true"] {
    opacity: 0.4;
    pointer-events: none;
  }

  .article-tools-icon {
    display: inline-flex;
  }
</style>
