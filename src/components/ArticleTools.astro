---
import Icon from "./Icon.astro";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import { DEFAULT_READING_SCALE, READING_SCALES } from "../reading";

interface Props {
  /** The locale whose copy labels every control. */
  locale: Locale;
  /**
   * Where the bar sits. `rail` is the right rail at `xl` and above, after the
   * table of contents; `dock` is the end of `main` below `xl`.
   */
  placement: "rail" | "dock";
}

// One component, two placements, because the two are not the same node. The
// rail copy's sticky containing block is the rail column, whose bottom edge is
// the end of the article; the dock copy's is `main`, whose bottom edge is the
// footer's top. That is what makes `position: sticky; bottom: 0` do the whole
// job with no script and no measurement.
//
// The placement is the component's own two modifiers, not Bootstrap's display
// utilities: those carry `!important`, so neither the breakpoint nor the mode
// attribute could override them. Both copies are decided in the style block
// below, in one place.
//
// The component holds no script: it is rendered twice, so the behavior belongs
// to `Article.astro`, which renders both copies.
//
// Five of the six controls write document state or the clipboard, so without a
// script they are buttons that do nothing: they ship `hidden` and the page's
// script reveals every `[data-needs-script]`. The two that carry neither need no
// script - the anchor's `#top` fragment resolves to the document top with no
// element named for it, and the progress indicator is a scroll-driven animation.
const { locale, placement } = Astro.props;

const backToTop = t(locale, "text-action-back-to-top");
const comfortView = t(locale, "text-action-view-comfort");
const copyLink = t(locale, "text-action-copy-link");
const fontDecrease = t(locale, "text-action-font-decrease");
const fontIncrease = t(locale, "text-action-font-increase");
const fontSerif = t(locale, "text-action-font-serif");

// The steps reach the page's inline script through the bar's own attributes,
// because an inline script cannot import. Both copies carry the same pair, from
// this one list.
const readingSteps = READING_SCALES.join(" ");
const readingDefault = String(DEFAULT_READING_SCALE);
---

<div
  class:list={[
    "article-tools align-items-center px-3 px-xl-0",
    placement === "rail"
      ? "article-tools--rail"
      : "article-tools--dock border-top",
  ]}
  data-reading-steps={readingSteps}
  data-reading-default={readingDefault}
>
  {/* Both forms of the progress indicator: the ring is the rail's, the line is
      the dock's, and the placement classes above decide which exists. Each is
      one animation on a concrete property, which is why there are two nodes
      rather than one. The ring's box is a control-sized square so it sits in the
      bar's rhythm; the drawing inside it stays 24 px. */}
  <div class="article-tools-ring" aria-hidden="true">
    <svg viewBox="0 0 24 24">
      <circle
        class="article-tools-ring-track"
        cx="12"
        cy="12"
        r="11.5"
      ></circle>
      <circle class="article-tools-ring-arc" cx="12" cy="12" r="11"></circle>
    </svg>
  </div>
  <a
    class="article-tools-control"
    href="#top"
    aria-label={backToTop}
    title={backToTop}
  >
    <span class="article-tools-icon" aria-hidden="true">
      <Icon name="arrowUpward" />
    </span>
  </a>
  <button
    class="article-tools-control"
    type="button"
    data-copy-link
    data-needs-script
    hidden
    aria-label={copyLink}
    title={copyLink}
  >
    <span class="article-tools-icon" data-copy-icon aria-hidden="true">
      <Icon name="contentCopy" />
    </span>
    <span class="article-tools-icon" data-copied-icon aria-hidden="true">
      <Icon name="check" />
    </span>
  </button>
  <button
    class="article-tools-control"
    type="button"
    data-reading-step="-1"
    data-needs-script
    hidden
    aria-label={fontDecrease}
    title={fontDecrease}
  >
    <span class="article-tools-icon" aria-hidden="true">
      <Icon name="textDecrease" />
    </span>
  </button>
  <button
    class="article-tools-control"
    type="button"
    data-reading-step="1"
    data-needs-script
    hidden
    aria-label={fontIncrease}
    title={fontIncrease}
  >
    <span class="article-tools-icon" aria-hidden="true">
      <Icon name="textIncrease" />
    </span>
  </button>
  <button
    class="article-tools-control"
    type="button"
    data-face-toggle
    data-needs-script
    hidden
    aria-pressed="false"
    aria-label={fontSerif}
    title={fontSerif}
  >
    <span class="article-tools-icon" data-face-outline aria-hidden="true">
      <Icon name="serif" />
    </span>
    <span class="article-tools-icon" data-face-filled aria-hidden="true">
      <Icon name="serifFill" />
    </span>
  </button>
  <button
    class="article-tools-control"
    type="button"
    data-view-toggle
    data-needs-script
    hidden
    aria-pressed="false"
    aria-label={comfortView}
    title={comfortView}
  >
    <span class="article-tools-icon" aria-hidden="true">
      <Icon name="formatAlignCenter" />
    </span>
  </button>
  <div class="article-tools-line" aria-hidden="true"></div>
</div>

<style>
  /* Sticky, never fixed: the bar stays in flow, so what lifts it is the
     document's own structure rather than an offset someone measured.

     `margin-top: auto` is what puts the bar at the bottom of its containing
     block, and both placements need it. `position: sticky; bottom: 0` only ever
     moves an element up - it never pushes one down - so a bar left at the top of
     an empty stretch would ride up with the document instead of floating.

     The separating `border-top` is the dock copy's alone. Below `xl` the article
     scrolls under the bar, which is why that copy also needs the opaque
     background; in the rail nothing ever passes beneath it, and a line across
     the rail would separate the bar from nothing while standing beside the
     article's own footer rule at the bottom of the page - half its width, in the
     neighboring column, reading as two lines that failed to meet. The
     background stays on both: one declaration serves the two placements, and
     only the dock copy needs it. */
  .article-tools {
    position: sticky;
    bottom: 0;
    flex: none;
    margin-top: auto;
    z-index: var(--shar-z-tools);
    height: var(--shar-tools-height);
    background-color: var(--bs-body-bg);
  }

  /* Where each copy sits, in one place. The rail copy is the right rail's bar at
     `xl` and above; the dock copy is the end of `main` below it. */
  .article-tools--rail {
    display: none;
    justify-content: flex-end;
  }

  .article-tools--dock {
    display: flex;
    justify-content: space-around;
  }

  @media (min-width: 1200px) {
    .article-tools--rail {
      display: flex;
    }

    .article-tools--dock {
      display: none;
    }
  }

  /* The comfortable view docks the bar at every width, capped at the measure and
     centered, so it spreads its controls under the column they act on. At 1440
     `space-around` across the viewport would put one glyph at each edge, which is
     a toolbar-shaped void rather than a bar beside the article. `width: 100%` is
     load-bearing: with an auto cross-axis margin a flex item stops stretching,
     so without it the bar would shrink onto its own glyphs. */
  :root[data-reading-view="comfort"] .article-tools--rail {
    display: none;
  }

  :root[data-reading-view="comfort"] .article-tools--dock {
    display: flex;
    width: 100%;
    max-width: var(--shar-measure);
    margin-inline: auto;
  }

  /* The same gate `base.css` puts in front of its scale rules: the scale has no
     definition until a size is chosen, and a `calc` over a missing custom
     property is invalid, so the plain measure is what applies until then. */
  :root[data-reading-view="comfort"][data-reading-scale] .article-tools--dock {
    max-width: calc(var(--shar-measure) * var(--shar-reading-scale));
  }

  /* 44 px is the smallest comfortable thumb target. The glyph is sized as a
     `font-size` on this wrapper because `Icon.astro` renders through
     `set:html`, so the SVG carries no scope attribute and no scoped rule can
     name it. The color is the header control's own, so the two bars read as one
     system, and the underline is canceled because `base.css` gives every
     anchor one.

     The class serves an anchor and two buttons, so the UA chrome a `<button>`
     carries - its padding, border and background - is removed here rather than
     restated per element. */
  .article-tools-control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    font-size: 1.5rem;
    color: rgba(var(--bs-body-color-rgb), 0.8);
    text-decoration: none;
    background-color: transparent;
  }

  .article-tools-control:hover {
    color: var(--bs-body-color);
  }

  /* The end of the range. `aria-disabled` rather than `disabled`, so the control
     keeps focus instead of dropping it under a keyboard reader's fingers;
     `pointer-events` is what makes it unclickable, and the handler still guards
     the range because a keyboard activation dispatches a click regardless. */
  .article-tools-control[aria-disabled="true"] {
    opacity: 0.4;
    pointer-events: none;
  }

  .article-tools-icon {
    display: inline-flex;
  }

  /* The copy control's confirmation: one button, two glyphs, and one attribute
     on the button deciding which is drawn. Both copies of the button carry it,
     because the state lives on the document rather than in the pressed node, so
     a reader who switches placement mid-confirmation still sees the check. */
  .article-tools-control [data-copied-icon] {
    display: none;
  }

  .article-tools-control[data-copied] [data-copied-icon] {
    display: inline-flex;
  }

  .article-tools-control[data-copied] [data-copy-icon] {
    display: none;
  }

  /* The face toggle's two glyphs, decided by the `aria-pressed` the script
     already sets: the outlined face while the site's sans stack is in use, the
     filled one while the article is serif. Material Symbols' filled variant is
     the letter knocked out of a solid tile rather than a bolder letter - the
     frame's interior goes from 36% to 87% ink - which is what makes the state
     readable at this size. `format_align_center` has no filled counterpart, so
     the bar's other toggle shows its state only through `aria-pressed`. */
  .article-tools-control [data-face-filled] {
    display: none;
  }

  .article-tools-control[aria-pressed="true"] [data-face-filled] {
    display: inline-flex;
  }

  .article-tools-control[aria-pressed="true"] [data-face-outline] {
    display: none;
  }

  /* The progress indicator, in the form its placement calls for. The rail gets
     no line: its `border-top` was removed because nothing passes beneath that
     bar, so a line there would separate it from nothing - and a progress line is
     that same line in that same place.

     The ring is what the rail can carry: a control-sized box at the far left of
     the bar, an empty 24 px drawing inside it. `r=11` with a 2 px stroke puts the
     stroke's outer edge on the drawing's edge, and the circumference
     `2π·11 = 69.115` is both the dash length and the offset the arc rests at.
     `stroke-linecap: butt` because a round cap paints a bead at that offset, and
     `rotate(-90deg)` because SVG starts a circle at 3 o'clock while progress
     reads from the top. The track shares the arc's outer edge - `r=11.5` with a
     1 px stroke covers 11 to 12, inside the arc's 10 to 12 - so the arc hides it
     completely when the ring is full. A track drawn against the inner edge would
     still show at 100 %, reading as two concentric rings. */
  .article-tools-ring {
    display: none;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-inline-end: auto;
  }

  .article-tools-ring svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    transform: rotate(-90deg);
  }

  .article-tools-ring-track {
    stroke: var(--bs-border-color);
    stroke-width: 1;
  }

  .article-tools-ring-arc {
    stroke: var(--bs-primary);
    stroke-width: 2;
    stroke-linecap: butt;
    stroke-dasharray: 69.115;
    stroke-dashoffset: 69.115;
    animation-name: article-tools-ring;
    animation-timing-function: linear;
    animation-timeline: scroll(root block);
  }

  @keyframes article-tools-ring {
    from {
      stroke-dashoffset: 69.115;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  /* The line covers the dock's own border rather than stacking a second hairline
     beside it: `inset-block-start` is the border's row, and a positioned
     descendant paints over its containing block's border. It is twice the border
     so the accent reads at a glance, which puts one of its pixels over the bar's
     outer edge. The bar is `position: sticky`, which is already a containing
     block, so no wrapper is added. */
  .article-tools-line {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(-2 * var(--bs-border-width));
    height: calc(2 * var(--bs-border-width));
    display: none;
    background-color: var(--bs-primary);
    transform: scaleX(0);
    transform-origin: left;
    animation-name: article-tools-line;
    animation-timing-function: linear;
    animation-timeline: scroll(root block);
  }

  @keyframes article-tools-line {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  /* Which form exists follows the copy, so the breakpoint and the comfortable
     view need no rule of their own - they already decide the parent's display.
     The ring is gated as well as the animation, because its track is decoration
     that only means something under a moving arc: where the browser cannot
     animate on a scroll timeline the bar has no progress indicator at all,
     rather than a ring with nothing in it. The line needs no gate - it rests at
     zero width, so there it is simply invisible. */
  @supports (animation-timeline: scroll()) {
    .article-tools--rail .article-tools-ring {
      display: grid;
    }
  }

  .article-tools--dock .article-tools-line {
    display: block;
  }
</style>
