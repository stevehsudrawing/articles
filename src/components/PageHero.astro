---
import type { Trail } from "../breadcrumbs";
import type { PictureSource } from "../site-assets";
import Breadcrumbs from "./Breadcrumbs.astro";
import ThemeImage from "./ThemeImage.astro";

interface Props {
  /** The page's heading, rendered as the document's `h1`. */
  title: string;
  /** The page's introduction, under the heading. */
  description: string;
  /** The cover, when the page kind has one. */
  light?: PictureSource;
  /** The dark-theme variant, when the page declares a pair. */
  dark?: PictureSource;
  /**
   * What the artwork shows, when it is the page's own.
   *
   * Omitted for the site's default artwork: that picture is a placeholder
   * beside a heading which already names the page, so it stays decorative.
   */
  alt?: string;
  /** Where the page sits, for the kinds that have a trail above the heading. */
  trail?: Trail;
}

// A page opens with a heading, an introduction and - for the kinds that have
// one - a cover. The cover is never load-bearing: a page without one renders
// the same block with the text alone, so no layout shifts between page kinds.
//
// The row's gutters are `gx-4 gy-4`, and the horizontal one matters beyond this
// file: the cover's column is a third of the container, and the article page's
// table of contents is a third too, so the two share one right-rail width. The
// two-thirds width the heading gets is then the article body's own width. That
// is why the article layout's row carries a plain `g-4` - its horizontal half is
// the same 1.5rem as this `gx-4` - and why the two files say so in their own
// comments: changing one without the other moves the rails out of line.
const { title, description, light, dark, alt = "", trail } = Astro.props;

// The cover's box, breakpoint by breakpoint, measured on this page: a third of
// the container less its column's padding, so 416 at the widest. The browser
// picks a variant from this rather than from the column it sits in.
const COVER_SIZES =
  "(min-width: 1400px) 416px, (min-width: 1200px) 356px, (min-width: 992px) 296px, 320px";
---

<div class="page-hero container pb-4">
  <div class="row align-items-center gx-4 gy-4 my-2 my-lg-0">
    <div class:list={["col-12", light ? "col-lg-8" : ""]}>
      {trail && <Breadcrumbs trail={trail} />}
      <h1>{title}</h1>
      <p class="text-body-secondary mb-0">{description}</p>
    </div>
    {light && (
      <div class="page-hero-cover-column col-12 col-lg-4 order-first order-lg-last">
        <ThemeImage
          light={light}
          dark={dark}
          alt={alt}
          class="page-hero-cover"
          sizes={COVER_SIZES}
          priority
        />
      </div>
    )}
  </div>
</div>

<hr />

<style>
  .page-hero {
    min-height: 12rem;
    display: flex;
  }

  /* The row states its width because a flex item is sized by its content, not
     by its parent: without this, the row took whatever its two columns'
     intrinsic widths added up to, and the columns' own percentages then
     resolved against that instead of against the container. The cover is what
     made it visible - a `<picture>` contributes its own small intrinsic width,
     and the hero's third went from 440 to 322.

     The extra gutter is what a row in a block container gets for free: its
     negative margins cancel the container's padding, so it is `--bs-gutter-x`
     wider than the content box. Stated here, the hero's third stays the same
     width as the article page's table of contents below it. */
  .page-hero > .row {
    width: calc(100% + var(--bs-gutter-x));
  }

  hr {
    margin-top: 0;
  }

  .page-hero > .row > * {
    margin-top: 0;
  }

  /* 4:3 at every breakpoint, and no larger than 320x240 below the wide one -
     the same crop the list thumbnails use, so an author's "keep content inside
     the central 70%" rule covers both.

     Above the wide breakpoint the box fills its column instead, which is a
     third of the container. That is the rule this file shares with the article
     layout: one right-rail width, so the cover above the fold and the table of
     contents below it line up. A 4:3 box a third wide is about a quarter of the
     container tall - the height the main site's square cover occupies at a
     quarter wide. */
  .page-hero-cover {
    display: block;
    width: 100%;
    max-width: 320px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    /* The `<img>` carries the file's own `height` as a presentational hint, and
       an explicit height beats `aspect-ratio` - without this the box would be
       416x630 instead of 4:3. The card's cover says the same thing. */
    height: auto;
  }

  @media (min-width: 992px) {
    .page-hero-cover {
      max-width: none;
    }
  }

  /* Below the wide breakpoint the cover is the block's first line and the
     heading follows it - the order the main site's hero uses - and the image
     hugs the right edge of its column, which is what makes the stacked block
     read as artwork over text rather than as two left-aligned boxes.

     The order comes from Bootstrap's utilities on the column rather than from
     the markup, so the heading stays first in the document for a reader and
     for a browser without the stylesheet. The gap is declared here because the
     row's `gy-4` no longer supplies one: the hero zeroes its children's
     `margin-top` to keep Bootstrap's negative row margin from shifting the
     block. */
  @media (max-width: 991.98px) {
    .page-hero-cover-column {
      margin-bottom: 1.5rem;
    }

    .page-hero-cover {
      margin-left: auto;
    }
  }
</style>
