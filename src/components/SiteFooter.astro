---
import { feedUrl } from "../feed";
import { t } from "../i18n/messages";
import type { Locale } from "../i18n/locales";
import { REPOSITORY_URL } from "../site";
import Icon from "./Icon.astro";

interface Props {
  /** The locale this page is written in. */
  locale: Locale;
  /**
   * Whether the footer is the site's colophon in one line - the copyright and
   * the site's own name - rather than the banded row that also carries the feed
   * link and the license. Only the error page asks for it: it has one
   * exit already, and a link home here would be a second.
   */
  minimal?: boolean;
}

const { locale, minimal = false } = Astro.props;
const year = new Date().getFullYear();
const siteName = t(locale, "text-site-name");
---

<footer class={minimal ? "py-4 small" : "bg-body-tertiary py-4 mt-2 small"}>
  <div class="container">
    <div class="text-body-secondary d-flex flex-wrap gap-3">
      <p class="mb-0 flex-grow-1">
        {t(
          locale,
          "text-site-copyright",
          String(year),
          t(locale, "text-site-author"),
        )}
      </p>
      {minimal ? (
        <p class="mb-0">
          <b>{siteName}</b>
        </p>
      ) : (
        <>
          <p class="mb-0">
            <a href={feedUrl(locale)}>
              <span class="text-icon me-1" aria-hidden="true">
                <Icon name="rssFeed" />
              </span>
              {t(locale, "text-nav-feed")}
            </a>
          </p>
          <p class="mb-0">
            <a href={`${REPOSITORY_URL}/blob/main/LICENSE.md`} target="_blank">
              {t(locale, "text-nav-license")}
              <span class="link-indicator">
                <Icon name="arrowOutward" />
              </span>
            </a>
          </p>
        </>
      )}
    </div>
  </div>
</footer>
