---
import ArticleCard from "../../../../../components/ArticleCard.astro";
import Pagination from "../../../../../components/Pagination.astro";
import Page from "../../../../../layouts/Page.astro";
import { tagTrail } from "../../../../../breadcrumbs";
import { t } from "../../../../../i18n/messages";
import { getLocale, type Locale } from "../../../../../i18n/locales";
import { isIndexable, localesTagged } from "../../../../../public-pages";
import { tagPageUrl, tagPages } from "../../../../../tags";

const locale: Locale = "zh-hans";

// The locale is passed rather than read: `getStaticPaths` is hoisted to module
// scope and cannot see a frontmatter constant (measured on the list route).
export const getStaticPaths = tagPages("zh-hans");

const { page } = Astro.props;
const tag = Astro.params.tag!;
const label = t(locale, `text-tag-${tag}`);

// The tag set is the site's, so this page exists in every locale; only the
// locales that hold an article carrying the tag are its translations.
const alternates = (await localesTagged(tag)).map((other) => ({
  tag: getLocale(other).tag,
  href: tagPageUrl(other, tag, page.currentPage),
}));
---

<Page
  locale={locale}
  page="tags"
  heroTitle={label}
  heroDescription={t(locale, "text-hero-description-tag", label)}
  title={label}
  pageNumber={page.currentPage === 1 ? undefined : page.currentPage}
  path={`tags/${tag}/page/${page.currentPage}/`}
  noindex={!isIndexable({ articles: page.data.length })}
  trail={tagTrail(locale, tag)}
  alternates={alternates}
>
  {page.data.map((article) => (
    <ArticleCard locale={locale} article={article} />
  ))}
  <Pagination
    slot="strip"
    locale={locale}
    page={page}
    countKey="text-count-articles"
  />
</Page>
