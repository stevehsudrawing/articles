---
import { getCollection, render } from "astro:content";
import Article from "../../layouts/Article.astro";
import { articleSlugs, localesWith, redirectUrl } from "../../articles";
import type { Locale } from "../../i18n/locales";
import { tagPageUrl } from "../../tags";

const locale: Locale = "zh-hans";

// Every locale generates a route for every article the default locale has, so a
// missing translation has a URL that redirects rather than no URL at all. The
// build-time content checks run on the home page instead, because they have to
// run even when this route has nothing to render.

export async function getStaticPaths() {
  const slugs = await articleSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;

const target = await redirectUrl(slug, locale);
if (target) {
  return Astro.redirect(target);
}

const [entry] = await getCollection(locale, ({ id }) => id === slug);
const rendered = await render(entry);
const holding = await localesWith(slug);
---

<Article
  locale={locale}
  article={entry}
  rendered={rendered}
  languages={holding}
  tagHref={(tag) => tagPageUrl(locale, tag, 1)}
/>
