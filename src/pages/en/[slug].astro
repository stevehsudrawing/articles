---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Article from "../../layouts/Article.astro";
import {
  articleSlugs,
  articleUrl,
  assertDefaultCovers,
  localesWith,
  redirectUrl,
} from "../../articles";
import { getLocale, type Locale } from "../../i18n/locales";

const locale: Locale = "en";

// Every locale generates a route for every article the default locale has, so a
// missing translation has a URL that redirects rather than no URL at all. The
// build also fails here, by name, if a locale holds an article the default
// locale lacks.
await assertDefaultCovers();

export async function getStaticPaths() {
  const slugs = await articleSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;

const target = await redirectUrl(slug, locale);
if (target) {
  return Astro.redirect(target);
}

const [entry] = await getCollection(locale, ({ id }) => id === slug);
const rendered = await render(entry);
const holding = await localesWith(slug);

// `hreflang` marks real translations only: a locale whose page is a redirect is
// not a translation of the article, so it is never advertised as one.
const alternates = holding.map((other) => ({
  tag: getLocale(other).tag,
  href: articleUrl(other, slug),
}));
---

<Article
  locale={locale}
  article={entry}
  rendered={rendered}
  alternates={alternates}
  tagHref={(tag) => getRelativeLocaleUrl(locale, `tags/${tag}/`)}
/>
