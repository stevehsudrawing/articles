---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { coverPair } from "../articles";
import ArticleTools from "../components/ArticleTools.astro";
import PageHero from "../components/PageHero.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { LICENSES, type LicenseId } from "../content.config";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import { DEFAULT_READING_SCALE, readingScalePercent } from "../reading";
import {
  absoluteAsset,
  absoluteUrl,
  assertCoverFormat,
  assertCoverSize,
  IMAGES,
} from "../site-assets";
import Base from "./Base.astro";

/** What `render()` hands back, whose `Content` and `headings` are both used. */
type Rendered = Awaited<ReturnType<typeof render>>;

interface Props {
  /** The locale whose copy the page is written in. */
  locale: Locale;
  /** The article, as the collection hands it over. */
  article: CollectionEntry<Locale>;
  /** The rendered body and its headings. */
  rendered: Rendered;
  /** The tag pages this article's tags link to, in the current locale. */
  tagHref: (tag: string) => string;
  /** The locales that hold a real copy of this article, for `hreflang`. */
  alternates: { tag: string; href: string }[];
}

// The row is the layout: the article takes eight columns and the table of
// contents four, so the article's measure is narrower on wide screens than the
// container - the intended consequence of having a sidebar.
// The four columns are also the hero cover's column (see `PageHero.astro`): one
// third of the container is the right rail, and the cover above the fold lines
// up with the contents below it.
const { locale, article, rendered, tagHref, alternates } = Astro.props;
const { Content, headings } = rendered;
const cover = article.data.cover;

// A declared cover has to be the size a share card expects and a format one can
// show, and the layout is where its dimensions exist: the schema's `image()`
// resolves them after a refinement has run. The checks happen before anything
// renders, so a wrong cover fails the build instead of shipping a card a
// crawler has to crop or cannot read at all.
if (cover) {
  const entry = (field: string) => `${article.id}/${locale}.md cover.${field}`;
  assertCoverSize(cover.light, entry("light"));
  assertCoverFormat(cover.light, entry("light"));
  if (cover.dark) {
    assertCoverSize(cover.dark, entry("dark"));
    assertCoverFormat(cover.dark, entry("dark"));
  }
}

// The hero shows a pair: an article's own cover, or the site's default artwork
// when it declares none. Only the light half is ever advertised, because a
// crawler sends no `prefers-color-scheme` and would never see the dark one.
const heroCover = coverPair(article);

// `og:image` is the cover's own file - the one the hero already serves - so it
// is never re-encoded here; a 146 KB JPEG used to become a 512 KB PNG for a
// crawler that may never fetch it. The URL must be absolute because it is read
// outside any page, and the format checks above are what make "the cover
// itself" a safe thing to hand a crawler.
const ogImage = cover
  ? absoluteUrl(cover.light.src)
  : absoluteAsset(IMAGES.defaultCoverLight);

const license = LICENSES[article.data.license as LicenseId];
const licenseUrl = article.data.licenseUrl ?? license.url;
const author = article.data.author;
const updated = article.data.updated;
---

<Base
  locale={locale}
  description={article.data.description}
  title={article.data.title}
  path={`${article.id}/`}
  ogImage={ogImage}
  ogType="article"
  alternates={alternates}
>
  <PageHero
    title={article.data.title}
    description={article.data.description}
    light={heroCover.light}
    dark={heroCover.dark}
  />
  <div class="container pb-4">
    <div class="article-row row g-4">
      {/* A flex column so the bar's `margin-top: auto` can reach this column's
          bottom edge, which is the row's bottom - the end of the article. */}
      <div class="article-rail col-12 col-xl-4 order-xl-last d-flex flex-column">
        <TableOfContents locale={locale} headings={headings} />
        {/* The rail copy's sticky containing block is this column, so the bar
            floats at the viewport bottom and settles where the article ends. */}
        <ArticleTools locale={locale} placement="rail" />
      </div>
      <div class="article-wrapper col-12 col-xl-8">
        <article class="article-body" id="article-body">
          <Content />
        </article>
        <footer class="border-top pt-3 mt-4">
          {article.data.tags && (
            <ul class="list-inline mb-2">
              {article.data.tags.map((tag) => (
                <li class="list-inline-item">
                  <a
                    class="badge text-bg-secondary text-decoration-none"
                    href={tagHref(tag)}
                  >
                    {t(locale, `text-tag-${tag}`)}
                  </a>
                </li>
              ))}
            </ul>
          )}
          <ul class="text-body-secondary mb-0 small list-unstyled">
            <li>
              <span>{t(locale, "text-label-author")}: </span>
              <span class="font-tnum">
                {author ?? t(locale, "text-site-author")}
              </span>
            </li>
            <li>
              <span>{t(locale, "text-label-publish")}: </span>
              <span class="font-tnum">{article.data.date}</span>
            </li>
            {updated && (
              <li>
                <span>{t(locale, "text-label-update")}: </span>
                <span class="font-tnum">{updated}</span>
              </li>
            )}
            <li>
              <span>{t(locale, "text-label-license")}: </span>
              {licenseUrl ? (
                <a href={licenseUrl} rel="license noopener" target="_blank">
                  {license.label}
                </a>
              ) : (
                license.label
              )}
            </li>
          </ul>
        </footer>
      </div>
    </div>
  </div>

  {/* Below `xl` this is the last child of `main`, whose bottom edge is the
      footer's top edge - which is what makes the footer lift the bar without a
      script or a measured offset. */}
  <ArticleTools locale={locale} placement="dock" />

  {/* One live region for both bar copies: a region inside the component would
      be rendered twice and announce every step twice. It is hidden, so where it
      sits does not matter. `aria-atomic` makes the caption part of every
      announcement rather than a bare "110%". */}
  <p class="visually-hidden" aria-live="polite" aria-atomic="true">
    {t(locale, "text-label-font-scale")}{" "}
    <span data-reading-status>
      {readingScalePercent(DEFAULT_READING_SCALE)}%
    </span>
  </p>

  {/* The bar is rendered twice, so its behavior lives here, once: one delegated
      handler serves both copies and they cannot disagree. Inline, because the
      state is attributes on the document and an island would cost the Vue
      runtime for it. Nothing is stored - a reload is the reset. */}
  <script is:inline>
    (() => {
      const bar = document.querySelector("[data-reading-steps]");
      const status = document.querySelector("[data-reading-status]");
      const root = document.documentElement;
      if (!bar) return;

      const steps = bar.dataset.readingSteps.split(" ").map(Number);
      const fallback = steps.indexOf(Number(bar.dataset.readingDefault));

      // The current step is read back from the document, so the two copies and
      // a later script share one source of truth. String comparison, because
      // the attribute holds the scale as written.
      const current = () => {
        const index = steps.findIndex(
          (step) => String(step) === root.dataset.readingScale,
        );
        return index === -1 ? fallback : index;
      };

      const apply = (index) => {
        const scale = String(steps[index]);
        root.dataset.readingScale = scale;
        root.style.setProperty("--shar-reading-scale", scale);

        for (const control of document.querySelectorAll(
          "[data-reading-step]",
        )) {
          const direction = Number(control.dataset.readingStep);
          const done = direction < 0 ? index === 0 : index === steps.length - 1;
          control.setAttribute("aria-disabled", String(done));
        }

        if (status) status.textContent = Math.round(steps[index] * 100) + "%";
      };

      // The view is a second branch of the same handler, for the same reason as
      // the first: the bar is rendered twice. The attribute's absence is the
      // normal view, so nothing has to be initialized.
      const viewToggles = document.querySelectorAll("[data-view-toggle]");

      const setView = (comfort) => {
        const pressed = document.activeElement.closest("[data-view-toggle]");

        if (comfort) {
          root.dataset.readingView = "comfort";
        } else {
          delete root.dataset.readingView;
        }

        for (const toggle of viewToggles) {
          toggle.setAttribute("aria-pressed", String(comfort));
        }

        // The copy that was pressed is the one the new view hides - the rail
        // above `xl`, the dock below it - so focus would fall back to the
        // document and a keyboard reader would start over. The same control in
        // the visible copy takes it instead.
        if (pressed) {
          for (const toggle of viewToggles) {
            if (toggle.getClientRects().length > 0) {
              toggle.focus();
              break;
            }
          }
        }
      };

      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (!target) return;

        if (target.closest("[data-view-toggle]")) {
          setView(root.dataset.readingView !== "comfort");
          return;
        }

        const control = target.closest("[data-reading-step]");
        if (!control) return;

        // `pointer-events: none` stops a pointer, not a keyboard activation, so
        // the range is guarded here as well.
        const next = current() + Number(control.dataset.readingStep);
        if (next < 0 || next >= steps.length) return;
        apply(next);
      });
    })();
  </script>
</Base>

<style is:inline>
  /* The bar's height is reserved at the bottom of this page alone: beside
     `scroll-padding-top` in `base.css` it would reserve 64 px on the home, the
     list and every tag page, where no bar exists. */
  :root {
    scroll-padding-bottom: var(--shar-tools-height);
  }

  @media (max-width: 1199.98px) {
    .article-wrapper {
      margin-top: 1rem;
    }
  }
</style>

<style>
  /* The row's second composition, and why it is one declaration.

     `display: block` retires the column widths and the ordering together:
     `order` applies only to flex and grid items, so it stops applying at all,
     and the columns become block boxes whose width is ours. Bootstrap's
     `.col-xl-8` is a plain declaration, so the selector below outranks it
     rather than fighting it with `!important`.

     `margin-inline: 0` is the second half of that:
     `.row` carries a negative gutter that cancels the container's horizontal
     padding, which the columns' own gutters then put back. With those gutters
     zeroed (below) the negative margin would be the last word and the text would
     sit flush against a 375px viewport's edges - measured at 0 to 360 rather than
     the 12 to 348 it needs. Zeroing the row's margin leaves the container's
     padding as the only inset. */
  :root[data-reading-view="comfort"] .article-row {
    display: block;
    margin-inline: 0;
  }

  /* `padding-inline: 0` is what makes the measure the width of the text: `g-4`
     gives each column a 0.75rem gutter, so a 528px box would otherwise hold
     504px of prose. Both columns keep their own display mode, so the rail
     column stays the flex column the bar's `margin-top: auto` needs. */
  :root[data-reading-view="comfort"] .article-rail,
  :root[data-reading-view="comfort"] .article-wrapper {
    width: 100%;
    max-width: var(--shar-measure);
    margin-inline: auto;
    padding-inline: 0;
  }

  /* The scaled measure, gated on the scale attribute exactly as `base.css`
     gates its own rules: `--shar-reading-scale` has no definition until a reader
     steps the size, and a `calc` that multiplies a missing custom property is
     invalid at computed-value time - the cap would vanish in the common case,
     because the view attribute does not imply the scale one. */
  :root[data-reading-view="comfort"][data-reading-scale] .article-rail,
  :root[data-reading-view="comfort"][data-reading-scale] .article-wrapper {
    max-width: calc(var(--shar-measure) * var(--shar-reading-scale));
  }

  /* Stacked, the contents and the article need the distance the
     `max-width: 1199.98px` block above already gives them. The two rules set one
     property under different conditions, so neither adds to the other.

     The hero is deliberately left out: it keeps the container's width while this
     row centers at the measure, so the cover overhangs the column and the title
     starts further left than the body. The `<hr>` between them is the seam that
     makes that read as a masthead. */
  :root[data-reading-view="comfort"] .article-wrapper {
    margin-top: 1rem;
  }
</style>
