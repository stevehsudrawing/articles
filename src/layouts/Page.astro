---
import PageHero from "../components/PageHero.astro";
import type { Locale } from "../i18n/locales";
import Base from "./Base.astro";

interface Props {
  /** The locale whose copy the page is written in. */
  locale: Locale;
  /** Which of the header's items this page is. */
  page: "home" | "list" | "tags";
  /** The hero's heading, which is also the page's `h1`. */
  heroTitle: string;
  /** The hero's introduction. */
  heroDescription: string;
  /**
   * The page's own name for the document title. Omitted on the home page,
   * where the title is the site's name and nothing else.
   */
  title?: string;
  /** The list's page number, folded into the document title. */
  pageNumber?: number;
  /** The cover's URL, for the page kinds that have one. */
  light?: string;
  dark?: string;
  /** The page's path inside its locale, for the language switcher. */
  path?: string;
  /** The translations this page really has, for `hreflang`. */
  alternates?: { tag: string; href: string }[];
}

// The page kinds share one hero and one container; only the home has a cover,
// and a page without one renders the same block with the text alone.
const {
  locale,
  page,
  heroTitle,
  heroDescription,
  title,
  pageNumber,
  light,
  dark,
  path = "",
  alternates,
} = Astro.props;
---

<Base
  locale={locale}
  page={page}
  description={heroDescription}
  title={title}
  pageNumber={pageNumber}
  path={path}
  alternates={alternates}
>
  <PageHero
    title={heroTitle}
    description={heroDescription}
    light={light}
    dark={dark}
  />
  <div class="container pb-4">
    <div class="row g-2">
      <slot />
    </div>
  </div>
  {Astro.slots.has("strip") && (
    <div class="page-strip border-top mt-auto">
      <div class="container">
        <slot name="strip" />
      </div>
    </div>
  )}
</Base>

<style>
  /* The page frame's bottom edge: a rule across the viewport with the content on
     the same container grid as everything above it, and `mt-auto` - which needs
     `main` to be a flex column (see `Base.astro`) - to park it just above the
     footer whenever the page is shorter than the viewport. A page that passes no
     strip renders none, so the article and the home look exactly as before. */
  .page-strip {
    padding-top: 1rem;
    padding-bottom: 0.5rem;
  }
</style>
