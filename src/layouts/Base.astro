---
// The import order is the cascade: Bootstrap first, then our sheets, with
// `base.css` last of the four that mirror the main site because its rules
// restate Bootstrap's component variables at the same specificity, and
// `syntax.css` after it because its selectors have to outrank the others on the
// same element.
import "bootstrap/dist/css/bootstrap.min.css";
import "../styles/theme.css";
import "../styles/parameters.css";
import "../styles/fonts.css";
import "../styles/base.css";
import "../styles/syntax.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { listUrl } from "../articles";
import type { Trail } from "../breadcrumbs";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteIcons from "../components/SiteIcons.astro";
import { feedUrl } from "../feed";
import { t } from "../i18n/messages";
import {
  defaultLocale,
  getLocale,
  locales,
  type Locale,
} from "../i18n/locales";
import {
  breadcrumbNode,
  localeSite,
  pageGraph,
  serializeGraph,
  type JsonLdNode,
} from "../jsonld";
import { llmsUrl } from "../llms";
import { IMAGES, siteCard, type ShareImage } from "../site-assets";
import { tagIndexUrl } from "../tags";

interface Props {
  /** The locale whose language and BCP-47 tag the document carries. */
  locale: Locale;
  /** Which of the header's items this page is, for `aria-current`. */
  page?: "home" | "list" | "tags";
  /**
   * Whether the page renders the site's minimal chrome: no header, and a
   * one-line colophon instead of the banded footer. The error page is the only
   * caller - it is reached on a wrong address and offers one way back, so it
   * needs neither the navigation nor the theme control that rides with it.
   */
  minimal?: boolean;
  /** The page's introduction: the hero's lede, and the card's text. */
  description: string;
  /** The page's own title. Omitted on the home page, which is the site name. */
  title?: string;
  /** The list's page number: it reaches the title and never the heading. */
  pageNumber?: number;
  /**
   * The page's own path inside its locale (`page/2/`, `<slug>/`), which is what
   * the language switcher links to. Every locale serves the same shape, so the
   * switcher never has to know which of them holds a translation.
   */
  path?: string;
  /** Whether the page should stay out of search results. */
  noindex?: boolean;
  /**
   * The image a shared link shows, with the size and description a crawler
   * needs before it fetches it. Defaults to the site card, which is what a page
   * with no artwork of its own advertises.
   */
  ogImage?: ShareImage;
  /**
   * What the page is, for `og:type`: an article is a document of its own,
   * every other page is part of the site.
   */
  ogType?: "website" | "article";
  /** The translations this page really has, for `hreflang`. */
  alternates?: { tag: string; href: string }[];
  /**
   * The nodes this page adds to its graph, holding what only the page can
   * build - an article's `BlogPosting`. Everything else about the page is
   * already here, so a layout never assembles a graph of its own.
   */
  structuredData?: JsonLdNode[];
  /**
   * The page's markdown copy, when it has one - an article's `index.md`. It is
   * the layout's to name because the article is the only page kind with a copy.
   */
  markdown?: string;
  /**
   * Where the page sits, for the kinds that show a trail. The layouts render
   * it; this one turns it into the graph's `BreadcrumbList`, so no layout
   * assembles structured data by hand.
   */
  trail?: Trail;
}

const {
  locale,
  page,
  minimal = false,
  description,
  title,
  pageNumber,
  path = "",
  noindex = false,
  ogImage,
  ogType = "website",
  alternates = [],
  structuredData,
  markdown,
  trail,
} = Astro.props;

const entry = getLocale(locale);
const siteName = t(locale, "text-site-name");
// The suffix `<title>` uses. The formal name is 18 characters in Chinese and
// names the site; a search result spends too much of its width on it.
const shortSiteName = t(locale, "text-site-name-short");
const absolute = (href: string) => new URL(href, Astro.site).href;

// The composition has one home: the page hands over its own title and, on a
// paginated page, its number, and the number arrives through a message so a
// locale can put it where its own grammar does. `<title>` and `og:title` read
// this one string, so a shared link cannot be named differently from the tab.
const documentTitle = !title
  ? siteName
  : pageNumber
    ? t(locale, "text-title-paged", title, String(pageNumber))
    : `${title} - ${shortSiteName}`;

// The page's own address: `Astro.url` carries the path the build rendered and
// the base in front of it, and making it absolute against the site is what a
// shared link needs - a crawler reads it outside the page it came from.
const canonical = absolute(Astro.url.pathname);

// The site card's alt names the site, because the artwork is the site's.
const card = ogImage ?? siteCard(IMAGES.siteCard, siteName);

// The page's structured data. It is composed here rather than passed in
// because the two facts it needs most - the composed title and the canonical
// address - are this file's, and a layout handing over a whole graph would
// derive both a second time. The trail arrives as a page fact and leaves as a
// node, so no layout has to know `BreadcrumbList` exists.
const graph = pageGraph({
  site: localeSite(locale),
  url: canonical,
  name: documentTitle,
  description,
  siteName,
  siteAuthor: t(locale, "text-site-author"),
  type: ogType === "article" ? "WebPage" : "CollectionPage",
  nodes: [
    ...(structuredData ?? []),
    ...(trail ? [breadcrumbNode(trail, canonical)] : []),
  ],
});
const jsonLd = serializeGraph(graph);

// The list's own URL is its first page: `/page/` exists only as a redirect, and
// no in-site link should need one. The tag index follows the same shape, and
// both paths come from the modules that build them, because the breadcrumb is
// their third reader.
const nav = [
  { kind: "home", href: getRelativeLocaleUrl(locale, "") },
  { kind: "list", href: listUrl(locale) },
  { kind: "tags", href: tagIndexUrl(locale) },
].map(({ kind, href }) => ({
  href,
  label: t(locale, `text-nav-${kind}`),
  current: page === kind,
}));

const languages = locales.map((other) => ({
  tag: other.tag,
  name: other.name,
  href: getRelativeLocaleUrl(other.identity, path),
  current: other.identity === locale,
}));

const themes = (
  [
    ["auto", "contrast"],
    ["light", "lightMode"],
    ["dark", "darkMode"],
  ] as const
).map(([value, icon]) => ({
  value,
  icon,
  label: t(locale, `text-action-theme-${value}`),
}));
---

<!doctype html>
<html lang={entry.tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <SiteIcons />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        {/* One condition, because the facts share a reader: a page outside the
            index needs neither an address to consolidate nor a description to
            quote, and the 404 answers every unknown path, so a self-canonical
            would name a URL nobody requested. `hreflang` joins them because a
            translation is a page a crawler may index, so an unindexed page
            names none and no page names it. */}
        {alternates.map((alternate) => (
          <link
            rel="alternate"
            hreflang={alternate.tag}
            href={absolute(alternate.href)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={absolute(getRelativeLocaleUrl(defaultLocale, path))}
        />
        <meta name="robots" content="max-image-preview:large" />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {/* The feed this page belongs to, named for the software that looks for
            one. It sits in this branch because it is an advertisement like the
            rest: a page outside the index offers no subscription. */}
        <link
          rel="alternate"
          type="application/rss+xml"
          title={siteName}
          href={absolute(feedUrl(locale))}
        />
        {/* The page's copy in the author's own markdown, where it has one, and
            the file that lists every page - both the relations llms.txt v2
            recommends, and both advertisements like the feed's. */}
        {markdown && (
          <link
            rel="alternate"
            type="text/markdown"
            href={absolute(markdown)}
          />
        )}
        <link rel="describedby" href={absolute(llmsUrl())} />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:title" content={documentTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={card.url} />
        <meta property="og:image:width" content={String(card.width)} />
        <meta property="og:image:height" content={String(card.height)} />
        <meta property="og:image:alt" content={card.alt} />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content={ogType} />
        {/* The image is named in both namespaces, so a crawler that reads only
            its own tags and one that reads only Open Graph both find it. */}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={card.url} />
        {/* The page describes itself in one graph, and a page outside the
            index advertises nothing - so this rides the same branch the
            canonical does. `set:html` writes the JSON verbatim, which is why
            `serializeGraph()` escapes `<`: a closing tag inside a title would
            otherwise end this element. */}
        <script type="application/ld+json" set:html={jsonLd}></script>
      </>
    )}
    <script is:inline>
      // The theme has to be a concrete value before the first paint: Bootstrap
      // ships no automatic dark mode, so `auto` is resolved here and a system
      // change is followed while the page is open. This script owns the theme -
      // the stored choice is written here, the resolved one is applied here -
      // so the rule lives in one place rather than in two.
      //
      // `data-theme-choice` is the choice itself, which the header's markup
      // reads to show the chosen theme's glyph and label, and `data-bs-theme`
      // is what the page renders in. They differ while `auto` resolves to a
      // side of the system preference, which is why both are written.
      (() => {
        const system = matchMedia("(prefers-color-scheme: dark)");
        const apply = () => {
          const stored = localStorage.getItem("theme");
          const choice =
            stored === "light" || stored === "dark" ? stored : "auto";
          document.documentElement.dataset.bsTheme =
            choice === "auto" ? (system.matches ? "dark" : "light") : choice;
          document.documentElement.dataset.themeChoice = choice;

          // Runs before the body exists when it is called from the head, so it
          // finds nothing then and is called again once the markup is there.
          for (const item of document.querySelectorAll("[data-theme-option]")) {
            if (item.dataset.themeOption === choice) {
              item.setAttribute("aria-current", "true");
            } else {
              item.removeAttribute("aria-current");
            }
          }
        };
        apply();
        document.addEventListener("DOMContentLoaded", apply);
        system.addEventListener("change", apply);
        document.addEventListener("click", (event) => {
          const chosen = event.target.closest("[data-theme-option]");
          if (!chosen) return;

          localStorage.setItem("theme", chosen.dataset.themeOption);
          chosen.closest("details").open = false;
          apply();
        });
      })();
    </script>
  </head>
  <body class="d-flex flex-column min-vh-100">
    {/* The site's first focusable element: a keyboard reader's first Tab would
        otherwise land in the header and reaching the content would mean walking
        that navigation. Bootstrap's utility is the whole hiding mechanism - it
        clips the link to a pixel while nothing inside it has focus and stops
        matching when something does - and the position utilities are what
        replace that with `fixed`: in the flow the link existed only at the
        document top, so focusing it from mid-article scrolled the reader back
        there. Fixed, it is in the viewport at every scroll position and costs
        no layout. It navigates to a fragment, so it takes no `role="button"`. */}
    {!minimal && (
      <a
        class="skip-link visually-hidden-focusable btn btn-primary position-fixed top-0 start-0 m-2"
        href="#page-content"
      >
        {t(locale, "text-action-skip-to-content")}
      </a>
    )}
    {/* The header is markup, not an island: it is rendered here and needs
        nothing in the browser, so a page's only script is the theme's, inlined
        in the head above. The minimal chrome leaves the header out entirely. */}
    {!minimal && (
      <SiteHeader
        siteName={siteName}
        nav={nav}
        languages={languages}
        languageLabel={t(locale, "text-action-language")}
        themeLabel={t(locale, "text-action-theme")}
        menuLabel={t(locale, "text-action-menu")}
        settingsLabel={t(locale, "text-action-settings")}
        themes={themes}
      />
    )}
    {/* `d-flex flex-column` is what lets a page's own bottom strip - the
        pagination band `Page.astro` renders - park itself with `mt-auto`. */}
    <main id="page-content" class="flex-grow-1 d-flex flex-column">
      <slot />
    </main>
    <SiteFooter locale={locale} minimal={minimal} />
  </body>
</html>

<style>
  /* The header carries `--shar-z-header`, so the skip link needs a layer of its
     own to be visible once it is fixed over that corner. It reads the token
     rather than a literal, and only while focused: unfocused, Bootstrap's
     utility has already taken it out of the picture. */
  .skip-link:focus {
    z-index: var(--shar-z-skip);
  }
</style>
